{
  "manifest_version": 2,
  "name": "Quick Actions for Sankaku",
  "version": "{{VERSION}}",
  "description": "Rate posts, favorite them, bulk upload and hide ads on Sankaku Complex. Unofficial, not affiliated with the site.",
  "homepage_url": "https://github.com/MotoIlyuha/sankaku-quick-actions",
  "browser_specific_settings": {
    "gecko": {
      "id": "sankaku-quick-actions@skq",
      "strict_min_version": "60.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "storage",
    "https://www.sankakucomplex.com/*",
    "https://sankakucomplex.com/*",
    "https://sankaku.app/*"
  ],
  "background": { "scripts": ["background.js"], "persistent": false },
  "browser_action": {
    "default_title": "Quick Actions for Sankaku — settings",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://www.sankakucomplex.com/*",
        "https://sankakucomplex.com/*",
        "https://sankaku.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": ["core-main.js"]
}
