{
  "manifest_version": 3,
  "name": "Sankaku: оценки и избранное без открытия поста",
  "version": "{{VERSION}}",
  "description": "Оценки и избранное прямо в сетке, хоткеи, массовая загрузка и скрытие рекламы на Sankaku Complex.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sankaku-quick-actions@skq",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.sankakucomplex.com/*",
    "https://sankakucomplex.com/*",
    "https://sankaku.app/*"
  ],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_title": "Sankaku: настройки скрипта",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://www.sankakucomplex.com/*",
        "https://sankakucomplex.com/*",
        "https://sankaku.app/*"
      ],
      "js": ["core-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.sankakucomplex.com/*",
        "https://sankakucomplex.com/*",
        "https://sankaku.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core-main.js"],
      "matches": [
        "https://www.sankakucomplex.com/*",
        "https://sankakucomplex.com/*",
        "https://sankaku.app/*"
      ]
    }
  ]
}
